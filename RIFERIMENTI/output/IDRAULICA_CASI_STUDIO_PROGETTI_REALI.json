        "forza_totale_per_metro": {
          "formula": "F = ∫[0 to H] ρgz × dz = ρg × (H²/2)",
          "calcolo": "9,810 × (30²/2) = 4,414,500 N/m",
          "risultato": "4,414.5 kN/m"
        },
        "forza_totale_diga": {
          "lunghezza_m": 150,
          "calcolo": "4,414.5 kN/m × 150 m",
          "risultato": "662,175 kN ≈ 662 MN"
        },
        "centro_pressione": {
          "profondità_m": 20,
          "formula": "2H/3 = 2 × 30 / 3 = 20 m sotto superficie"
        }
      },
      "verifiche_stabilita": {
        "momento_ribaltante": {
          "formula": "M_ribaltante = F × (H/3)",
          "calcolo": "662,175 kN × (30/3)",
          "risultato": "6,621,750 kN·m"
        },
        "peso_diga": {
          "volume_calcestruzzo_m3": 60000,
          "peso_specifico_kN_m3": 24,
          "peso_totale_kN": 1440000
        },
        "momento_stabilizzante": {
          "formula": "M_stabilizzante = peso × (distanza_base/2)",
          "calcolo": "1,440,000 kN × (15 m base/2)",
          "risultato": "10,800,000 kN·m"
        },
        "coefficiente_sicurezza": {
          "formula": "CS = M_stabilizzante / M_ribaltante",
          "calcolo": "10,800,000 / 6,621,750",
          "risultato": 1.63,
          "nota": "Target minimo ≈ 1.5, quindi diga è stabile ✓"
        }
      }
