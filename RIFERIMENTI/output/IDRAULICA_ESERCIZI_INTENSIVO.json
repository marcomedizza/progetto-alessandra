  "giorni_esercizi": [
    {
      "giorno": "GIORNO 1 (LUN 31 AGO)",
      "tema": "Proprietà Fluidi & Statica",
      "esercizi": [
        {
          "numero": "1.1",
          "titolo": "Densità e Peso Specifico",
          "problema": "Un serbatoio contiene olio con densità ρ = 850 kg/m³. Calcolare: a) Peso specifico dell'olio, b) Massa di olio in serbatoio di 50 m³, c) Pressione sul fondo a profondità 4 m",
          "dati": {
            "densita_kg_m3": 850,
            "g_m_s2": 9.81,
            "volume_m3": 50,
            "profondita_m": 4
          },
          "soluzione": {
            "peso_specifico": {
              "formula": "γ = ρ × g",
              "calcolo": "850 × 9.81 = 8,338.5 N/m³",
              "risultato": "≈ 8.34 kN/m³"
            },
            "massa": {
              "formula": "m = ρ × V",
              "calcolo": "850 × 50 = 42,500 kg",
              "risultato": "42,500 kg"
            },
            "pressione_fondo": {
              "formula": "p = γ × h",
              "calcolo": "8,338.5 × 4 = 33,354 Pa",
              "risultato_relativa": "≈ 33.4 kPa",
              "risultato_assoluta": "33.4 + 101.3 = 134.7 kPa"
            }
          }
        },
        {
          "numero": "1.2",
          "titolo": "Viscosità e Numero Reynolds",
          "problema": "Nel tubo orizzontale di diametro 25 mm scorre olio (da Esercizio 1.1) a velocità media 2 m/s. Viscosità cinematica olio: ν = 15 × 10⁻⁶ m²/s. Calcolare: a) Numero Reynolds, b) Regime di flusso, c) Fattore di attrito",
          "dati": {
            "diametro_mm": 25,
            "velocita_m_s": 2,
            "viscosita_cinematica": "15 × 10⁻⁶ m²/s"
          },
          "soluzione": {
            "reynolds": {
              "formula": "Re = (v × D) / ν",
              "calcolo": "(2 × 0.025) / (15 × 10⁻⁶) = 3,333",
              "risultato": 3333
            },
            "regime": {
              "calcolo": "Re = 3,333 → FLUSSO TURBOLENTO (Re > 2000)",
              "nota": "Confine a Re ≈ 2000-2300 per tubi lisci"
            },
            "fattore_attrito": {
              "formula": "f = 0.316 / Re^0.25 (Blasius)",
              "calcolo": "0.316 / (3333)^0.25 = 0.316 / 7.58",
              "risultato": "≈ 0.042"
            }
          }
        },
        {
          "numero": "1.3",
          "titolo": "Spinta Idrostatica su Parete",
          "problema": "Serbatoio rettangolare con parete verticale di larghezza 6 m, profondità acqua 3 m. Calcolare: a) Forza totale su parete, b) Profondità del centro di pressione, c) Momento ribaltante",
          "dati": {
            "larghezza_m": 6,
            "profondita_m": 3,
            "densita_kg_m3": 1000,
            "g_m_s2": 9.81
          },
          "soluzione": {
            "forza_totale": {
              "formula": "F = (1/2) × γ × H² × B",
              "calcolo": "(1/2) × 9810 × 3² × 6 = 264,870 N",
              "risultato": "≈ 265 kN"
            },
            "centro_pressione": {
              "formula": "zcp = H / 3",
              "calcolo": "3 / 3 = 1 m",
              "nota": "1/3 della profondità dal fondo, o 2/3 dal top"
            },
            "momento_ribaltante": {
              "formula": "M = F × (H/3)",
              "calcolo": "264,870 × (3/3) = 264,870 N·m",
              "nota": "Braccio è H/3 perché forza agisce a H/3 da fondo"
            }
          }
        },
        {
          "numero": "1.4",
          "titolo": "Principio di Pascal e Moltiplicatore Idraulico",
          "problema": "Pressa idraulica con cilindro piccolo (d₁ = 20 mm) e cilindro grande (d₂ = 100 mm). Forza applicata su cilindro piccolo: F₁ = 500 N. Calcolare: a) Pressione nel sistema, b) Forza su cilindro grande, c) Vantaggio meccanico",
          "dati": {
            "diametro_piccolo_mm": 20,
            "diametro_grande_mm": 100,
            "forza_piccolo_N": 500
          },
          "soluzione": {
            "pressione": {
              "formula": "p = F₁ / A₁ = F₁ / (π × r₁²)",
              "calcolo": "500 / (π × 0.01²) = 1,591,549 Pa",
              "risultato": "≈ 1.59 MPa"
            },
            "forza_grande": {
              "formula": "F₂ = p × A₂ = p × (π × r₂²)",
              "calcolo": "1,591,549 × (π × 0.05²) = 12,500 N",
              "risultato": "12,500 N"
            },
            "vantaggio_meccanico": {
              "formula": "VM = F₂ / F₁ = (d₂/d₁)²",
              "calcolo": "(100/20)² = 25",
              "risultato": 25
            }
          }
        },
        {
          "numero": "1.5",
          "titolo": "Barometro ad Acqua",
          "problema": "Barometro ad acqua (non a mercurio). Pressione atmosferica standard = 101,325 Pa. Calcolare altezza colonna d'acqua in equilibrio.",
          "dati": {
            "pressione_atmosferica_Pa": 101325,
            "densita_acqua_kg_m3": 1000,
            "g_m_s2": 9.81
          },
          "soluzione": {
            "altezza": {
              "formula": "p_atm = ρ_acqua × g × h",
              "calcolo": "101,325 / (1000 × 9.81) = 10.33 m",
              "risultato": "10.33 m"
            },
            "nota": "Barometri ad acqua sono impraticabili (~10 m di altezza!). Mercurio è usato: h = 0.76 m (760 mm)",
            "verifica_mercurio": {
              "densita_mercurio": 13600,
              "calcolo": "101,325 / (13,600 × 9.81) = 0.76 m ✓"
            }
          }
        }
      ]
    },
